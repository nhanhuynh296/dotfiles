#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

# Re-runs only when fzf's version changes: {{ output "sh" "-c" "PATH=\"$HOME/.local/bin:$PATH\" fzf --version 2>/dev/null || echo not-installed" | trim }}

mkdir -p "$HOME/.cache/fzf"
fzf --zsh > "$HOME/.cache/fzf/integration.zsh"

echo "Regenerated fzf zsh integration cache"
