#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

{{- if eq .environment "dev" }}
# Re-runs only when `just`'s version changes: {{ output "sh" "-c" "PATH=\"$HOME/.local/bin:$PATH\" just --version 2>/dev/null || echo not-installed" | trim }}

mkdir -p "$HOME/.oh-my-zsh/custom/completions"
just --completions zsh > "$HOME/.oh-my-zsh/custom/completions/_just"
rm -f "$HOME"/.zcompdump-*

echo "Regenerated just zsh completion"
{{- else }}
echo "Skipping just zsh completion generation: prod environment, just not installed"
{{- end }}
