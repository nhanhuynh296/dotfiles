[[mgr.prepend_keymap]]
on   = [ "g", "w" ]
run  = "cd ~/work"
desc = "Go to work directory"

[[mgr.prepend_keymap]]
on   = [ "g", "l" ]
run  = "cd ~/.local"

[[mgr.prepend_keymap]]
on   = [ "g", "s" ]
run  = "cd ~/.ssh"

[[mgr.prepend_keymap]]
{{ if eq .chezmoi.os "darwin" }}on   = "<A-s>"{{ else }}on   = "<C-s>"{{ end }}
run  = 'shell "$SHELL" --block --confirm'
desc = "Open shell here"

[[mgr.prepend_keymap]]
{{ if eq .chezmoi.os "darwin" }}on   = "<A-Down>"{{ else }}on   = "<C-Down>"{{ end }}
run  = 'arrow 5'

[[mgr.prepend_keymap]]
{{ if eq .chezmoi.os "darwin" }}on   = "<A-Up>"{{ else }}on   = "<C-Up>"{{ end }}
run  = 'arrow -5'


[[mgr.prepend_keymap]]
on   = [ "c", "m" ]
run  = "plugin chmod"
desc = "Chmod on selected files"

[[input.prepend_keymap]]
on   = "<Esc>"
run  = "close"
desc = "Cancel input"

[[mgr.prepend_keymap]]
on   = "<A-Enter>"
run  = 'open --interactive'
